---
import Icon from "./Icon.astro";

const points = [
  {
    k: "01",
    label: "Doar lucrări reale",
    t: "Fiecare fotografie de pe acest site e dintr-un proiect făcut de noi. Fără poze de stoc, fără exemple împrumutate.",
  },
  {
    k: "02",
    label: "Utilaje proprii",
    t: "Venim cu echipamentul nostru și cu oameni care știu ce fac. Nu depindem de terți ca să începem lucrarea.",
  },
  {
    k: "03",
    label: "Comunicare exactă",
    t: "Îți spunem clar ce se poate face, în cât timp și la ce să te aștepți. Fără promisiuni umflate și fără surprize.",
  },
  {
    k: "04",
    label: "La nivel național",
    t: "Ne deplasăm acolo unde este lucrarea, în funcție de proiect și de scopul ei. Întreabă pentru zona ta.",
  },
];
---

<section id="de-ce-noi" class="border-t border-line bg-sunken/60">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-x-12 gap-y-10 lg:grid-cols-12">
      <div class="reveal lg:col-span-5">
        <p class="spec-label">De ce noi</p>
        <h2 class="mt-3 text-[2rem] leading-[1.08] font-extrabold text-ink sm:text-[2.6rem]">
          Munca vorbește.
          <span class="text-ink-muted">Noi doar o arătăm clar.</span>
        </h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-ink-muted">
          Suntem o echipă care sapă corect și predă terenul așa cum trebuie.
          Nu căutăm să impresionăm cu vorbe, ci cu lucrări pe care le poți vedea
          mai sus.
        </p>
      </div>

      <dl class="lg:col-span-7">
        {
          points.map((p, i) => (
            <div
              class="reveal flex gap-5 border-t border-line py-6 first:border-t-0 first:pt-0"
              style={`--reveal-delay: ${i * 70}ms`}
            >
              <span class="mt-1 font-mono text-sm font-medium text-amber-strong tabular-nums">
                {p.k}
              </span>
              <div>
                <dt class="flex items-center gap-2 text-lg font-bold text-ink">
                  <Icon name="check" class="size-4 text-amber-strong" />
                  {p.label}
                </dt>
                <dd class="mt-1.5 leading-relaxed text-ink-muted">{p.t}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
