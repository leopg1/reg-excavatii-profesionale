  name === "check" && (
    <svg class={klass} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="m4 12.5 5 5 11-12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
